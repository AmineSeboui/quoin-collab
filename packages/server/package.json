{
  "name": "quoin-collab-server",
  "version": "0.2.0",
  "description": "A self-hostable Yjs collaboration server for Quoin: rooms, presence, persistence and horizontal fanout, with no transport of its own.",
  "license": "MIT",
  "author": {
    "name": "Amine Sboui",
    "url": "https://github.com/AmineSeboui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmineSeboui/quoin-collab.git",
    "directory": "packages/server"
  },
  "homepage": "https://quoincloud.com/docs/self-hosting",
  "bugs": {
    "url": "https://github.com/AmineSeboui/quoin-collab/issues"
  },
  "keywords": [
    "yjs",
    "collaboration",
    "websocket",
    "crdt",
    "quoin",
    "real-time",
    "self-hosted"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone/index.d.ts",
      "default": "./dist/standalone/index.js"
    },
    "./token": {
      "types": "./dist/token.d.ts",
      "default": "./dist/token.js"
    }
  },
  "bin": {
    "quoin-collab-server": "./dist/standalone/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/standalone/cli.ts",
    "start": "node dist/standalone/cli.js",
    "build": "tsc -p tsconfig.build.json",
    "build:bundle": "esbuild src/standalone/cli.ts --bundle --platform=node --target=node20 --format=esm --external:ws --external:pg --external:ioredis --outfile=bundle/cli.js"
  },
  "dependencies": {
    "lib0": "^0.2.112",
    "ws": "^8.18.3",
    "y-protocols": "^1.0.6"
  },
  "peerDependencies": {
    "yjs": "^13.6.0"
  },
  "optionalDependencies": {
    "ioredis": "^5.9.0",
    "pg": "^8.16.3"
  }
}
