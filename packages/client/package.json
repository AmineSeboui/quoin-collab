{
  "name": "quoin-collab-client",
  "version": "0.1.0",
  "description": "The browser provider for Quoin's collaboration server: one WebSocket, awareness, and a reconnect that survives a serverless function's time limit.",
  "license": "MIT",
  "author": {
    "name": "Amine Sboui",
    "url": "https://github.com/AmineSeboui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmineSeboui/quoin-collab.git",
    "directory": "packages/client"
  },
  "homepage": "https://quoincloud.com/docs/self-hosting",
  "bugs": {
    "url": "https://github.com/AmineSeboui/quoin-collab/issues"
  },
  "keywords": [
    "yjs",
    "collaboration",
    "websocket",
    "provider",
    "quoin",
    "awareness"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "lib0": "^0.2.112",
    "quoin-collab-protocol": "^0.1.0",
    "y-protocols": "^1.0.6"
  },
  "peerDependencies": {
    "yjs": "^13.6.0"
  }
}
